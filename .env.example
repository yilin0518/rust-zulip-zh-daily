# ===== 必填：Zulip bot 凭据（rust-lang Zulip 的 API 需要登录）=====
# 创建方法：登录 https://rust-lang.zulipchat.com -> 右上角设置(齿轮) -> Personal settings -> Bots
#   -> "Add a new bot" -> 选 Generic bot -> 记下 bot 邮箱和 API Key
# 本地运行：复制本文件为 .env 并填写（或直接设置系统环境变量）
# GitHub：把 ZULIP_EMAIL / ZULIP_API_KEY 添加到仓库 Settings -> Secrets and variables -> Actions
ZULIP_EMAIL=
ZULIP_API_KEY=

# ===== 翻译后端（可选）=====
# 默认 auto：优先 Google（免费、无需 key，适合 GitHub Actions 环境），失败自动降级 MyMemory。
# 可选值：google | mymemory | deepl | ark
# - deepl：质量好，免费 key 在 https://www.deepl.com/zh/account/summary 获取（形如 xxxx:fx）
# - ark  ：火山方舟豆包大模型，质量最好，需在 https://console.volcengine.com/ark 创建 API Key 与推理接入点
# 本地在中国大陆网络运行时，Google 常被拦截，建议 TRANSLATE_BACKEND=mymemory
TRANSLATE_BACKEND=auto
DEEPL_API_KEY=
ARK_API_KEY=
ARK_MODEL=
# MyMemory 邮箱参数：匿名每天 5000 字符，填邮箱后每天 5 万字符
MYMEMORY_EMAIL=

# ===== 内容（可选）=====
# 每个频道展示的最新话题数（默认 20）
TOPICS_PER_STREAM=20
# 自定义频道列表（逗号分隔，默认 general,t-compiler,t-libs,t-opsem）
STREAMS=
