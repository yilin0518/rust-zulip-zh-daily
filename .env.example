# ===== 必填：Zulip bot 凭据（rust-lang Zulip 的 API 需要登录）=====
# 创建方法：登录 https://rust-lang.zulipchat.com -> 右上角设置(齿轮) -> Personal settings -> Bots
#   -> "Add a new bot" -> 选 Generic bot -> 记下 bot 邮箱和 API Key
# 本地运行：复制本文件为 .env 并填写（或直接设置系统环境变量）
# GitHub：把 ZULIP_EMAIL / ZULIP_API_KEY 添加到仓库 Settings -> Secrets and variables -> Actions
ZULIP_EMAIL=
ZULIP_API_KEY=

# ===== 按频道选择翻译服务 =====
# 未写入路由的频道使用 TRANSLATE_BACKEND；用 + 声明降级链，如 mymemory+openai。
TRANSLATE_BACKEND=mymemory
STREAM_TRANSLATE_BACKENDS=general=mymemory,t-compiler=mymemory,t-libs=mymemory,t-opsem=mymemory
DEEPL_API_KEY=
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# ===== OpenAI 兼容 AI 服务（帖子总结，也可用于翻译）=====
# 官方 OpenAI：BASE_URL 保持默认；第三方服务：填写其 OpenAI 兼容 API 根地址。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 帖子 AI 总结并发数；第三方服务限流严格时可调低为 1
AI_CONCURRENCY=4
# MyMemory 邮箱参数：匿名每天 5000 字符，填邮箱后每天 5 万字符
MYMEMORY_EMAIL=

# ===== 内容（可选）=====
# 每个频道展示的最新话题数（默认 20）
TOPICS_PER_STREAM=20
# 自定义频道列表（逗号分隔，默认 general,t-compiler,t-libs,t-opsem）
STREAMS=
